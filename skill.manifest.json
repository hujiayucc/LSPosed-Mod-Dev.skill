{
  "name": "LSPosed-Mod-Dev",
  "version": "1.0.2",
  "language": "zh-CN",
  "purpose": "低Token常驻启动 + 按需检索完整知识库、模板和真实案例，用于合法授权的LSPosed模块开发。",
  "entrypoint": {
    "type": "startup_prompt",
    "path": "SKILL.md",
    "load_policy": "always",
    "description": "唯一常驻加载文件。包含角色、安全边界、默认工作流、输出格式、章节索引和按需检索策略。"
  },
  "knowledge_base": [
    {
      "path": "LSPosed-Mod-Dev.full.knowledge.md",
      "type": "full_knowledge",
      "load_policy": "retrieve_on_demand",
      "priority": 30,
      "description": "完整知识库。保留所有LSPosed模块开发知识点，不应全量常驻注入上下文。"
    }
  ],
  "resources": [
    {
      "path": "templates/java-api102.md",
      "type": "template",
      "load_policy": "retrieve_on_code_generation",
      "priority": 80,
      "tags": [
        "java",
        "api102",
        "module-entry",
        "hook-template"
      ]
    },
    {
      "path": "templates/kotlin-api102.md",
      "type": "template",
      "load_policy": "retrieve_on_code_generation",
      "priority": 80,
      "tags": [
        "kotlin",
        "api102",
        "module-entry",
        "hook-template"
      ]
    },
    {
      "path": "templates/module-files.md",
      "type": "template",
      "load_policy": "retrieve_on_project_setup",
      "priority": 90,
      "tags": [
        "gradle",
        "module.prop",
        "java_init.list",
        "scope.list",
        "metadata"
      ]
    },
    {
      "path": "guides/quick-start.md",
      "type": "user_guide",
      "load_policy": "retrieve_on_onboarding",
      "priority": 75,
      "tags": [
        "quick-start",
        "onboarding",
        "usage",
        "prompts"
      ]
    },
    {
      "path": "guides/faq-anti-patterns.md",
      "type": "user_guide",
      "load_policy": "retrieve_on_faq_or_quality_check",
      "priority": 78,
      "tags": [
        "faq",
        "anti-patterns",
        "safety-rewrite",
        "quality"
      ]
    },
    {
      "path": "guides/troubleshooting-cards.md",
      "type": "user_guide",
      "load_policy": "retrieve_on_troubleshooting",
      "priority": 85,
      "tags": [
        "troubleshooting",
        "quick-cards",
        "hook-failure",
        "crash",
        "hot-reload",
        "native-hook"
      ]
    },
    {
      "path": "guides/interaction-examples.md",
      "type": "user_guide",
      "load_policy": "retrieve_on_interaction_design",
      "priority": 72,
      "tags": [
        "examples",
        "answers",
        "structured-feedback",
        "onboarding"
      ]
    },
    {
      "path": "guides/advanced-combinations.md",
      "type": "user_guide",
      "load_policy": "retrieve_on_complex_scenario",
      "priority": 82,
      "tags": [
        "multi-process",
        "classloader",
        "remote-preferences",
        "hot-reload",
        "native-hook",
        "architecture"
      ]
    },
    {
      "path": "guides/stability-strategy.md",
      "type": "user_guide",
      "load_policy": "retrieve_on_stability_review",
      "priority": 83,
      "tags": [
        "stability",
        "retry",
        "timeout",
        "validation",
        "fallback",
        "logging"
      ]
    },
    {
      "path": "cases/real-project-patterns.md",
      "type": "case_index",
      "load_policy": "retrieve_on_architecture_or_troubleshooting",
      "priority": 70,
      "tags": [
        "real-projects",
        "architecture",
        "quality",
        "troubleshooting",
        "api102"
      ]
    },
    {
      "path": "cases/migration-compat.md",
      "type": "case_index",
      "load_policy": "retrieve_on_migration",
      "priority": 70,
      "tags": [
        "legacy",
        "migration",
        "compatibility",
        "api100",
        "api101"
      ]
    }
  ],
  "retrieval_rules": [
    {
      "intent": "onboarding_or_usage_help",
      "read": [
        "guides/quick-start.md",
        "README.md"
      ]
    },
    {
      "intent": "faq_or_anti_pattern_check",
      "read": [
        "guides/faq-anti-patterns.md",
        "cases/real-project-patterns.md"
      ]
    },
    {
      "intent": "module_not_working_or_crash",
      "read": [
        "guides/troubleshooting-cards.md",
        "guides/faq-anti-patterns.md",
        "LSPosed-Mod-Dev.full.knowledge.md#排错章节",
        "cases/real-project-patterns.md"
      ]
    },
    {
      "intent": "interaction_examples_or_feedback",
      "read": [
        "guides/interaction-examples.md",
        "guides/quick-start.md"
      ]
    },
    {
      "intent": "complex_scenario_combination",
      "read": [
        "guides/advanced-combinations.md",
        "templates/java-api102.md 或 templates/kotlin-api102.md",
        "LSPosed-Mod-Dev.full.knowledge.md#相关章节"
      ]
    },
    {
      "intent": "stability_review_or_fallback",
      "read": [
        "guides/stability-strategy.md",
        "guides/troubleshooting-cards.md"
      ]
    },
    {
      "intent": "new_module_project",
      "read": [
        "SKILL.md",
        "templates/module-files.md",
        "templates/java-api102.md 或 templates/kotlin-api102.md"
      ]
    },
    {
      "intent": "api_detail_or_concept",
      "read": [
        "SKILL.md",
        "LSPosed-Mod-Dev.full.knowledge.md#相关章节"
      ]
    },
    {
      "intent": "remote_preferences_or_service",
      "read": [
        "LSPosed-Mod-Dev.full.knowledge.md#service与Remote Preferences章节"
      ]
    },
    {
      "intent": "hot_reload",
      "read": [
        "LSPosed-Mod-Dev.full.knowledge.md#Hot Reload章节"
      ]
    },
    {
      "intent": "native_hook",
      "read": [
        "LSPosed-Mod-Dev.full.knowledge.md#Native Hook章节"
      ]
    },
    {
      "intent": "legacy_migration",
      "read": [
        "cases/migration-compat.md",
        "LSPosed-Mod-Dev.full.knowledge.md#旧API兼容与迁移章节"
      ]
    },
    {
      "intent": "architecture_review_or_troubleshooting",
      "read": [
        "cases/real-project-patterns.md",
        "LSPosed-Mod-Dev.full.knowledge.md#排错与质量审查章节"
      ]
    }
  ],
  "token_strategy": {
    "always_load": [
      "SKILL.md"
    ],
    "never_always_load": [
      "LSPosed-Mod-Dev.full.knowledge.md",
      "templates/",
      "guides/",
      "cases/"
    ],
    "notes": "保留所有知识点，但只让启动版常驻。完整知识、模板、指南和案例通过语义检索或显式读取按需进入上下文。"
  },
  "safety": {
    "allowed": [
      "合法授权模块开发",
      "模块工程搭建",
      "Hook调试",
      "兼容适配",
      "旧API迁移",
      "日志排错",
      "代码质量审查"
    ],
    "refuse": [
      "绕过检测",
      "反作弊对抗",
      "隐蔽注入",
      "未授权修改第三方App",
      "窃取隐私或凭据",
      "破坏系统稳定",
      "恶意持久化"
    ]
  }
}
